# Copy to .env and fill in. Never commit .env.

# Sign-in. One admin account. The password should be long.
HTS_ADMIN_USERNAME=jason
HTS_ADMIN_PASSWORD=
HTS_SECRET_KEY=

# Where recordings, transcripts, reports, and the database live.
HTS_DATA_DIR=./data

# Delete the recording and transcript this many days after reports are generated.
# Must be a whole number from 0 to 14. Reports are kept.
RETENTION_DAYS=14

# AssemblyAI transcription and diarization.
ASSEMBLYAI_API_KEY=

# Gemini, via LangChain. GEMINI_API_KEY is accepted if GOOGLE_API_KEY is unset.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# dry-run saves emails under HTS_DATA_DIR/outbox and sends nothing.
# smtp uses the SMTP_* variables. api posts JSON to EMAIL_API_URL (Resend-shaped).
EMAIL_PROVIDER=dry-run

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Optional footer link on the PDFs. Leave blank to omit it.
HTS_FEEDBACK_URL=

# Upload limit, in megabytes.
HTS_MAX_UPLOAD_MB=500

# Set true when the app is served over HTTPS.
HTS_HTTPS_ONLY=false
